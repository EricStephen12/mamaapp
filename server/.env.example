PORT=4000

# Groq API Key (get from https://console.groq.com)
# Blazing fast Llama 3.3 70B & 8B inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# Flux Image Generation Provider (Choose one: 'cloudflare', 'fal', 'together', or curated fallback)
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI (100% Free - 10,000 neurons/day)
# Get from Cloudflare Dashboard -> AI -> Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Fal.ai API key (Fastest Flux schnell, 0.5s latency, ~$0.003/image)
FAL_KEY=your_fal_key_here

# Optional: Together AI API key if using Together
TOGETHER_API_KEY=your_together_key_here

# Optional: Replicate API token if using Replicate
REPLICATE_API_TOKEN=your_replicate_token_here
